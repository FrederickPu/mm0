axiom LE_Type (F: expr) (G: ctx) (K: indspec) (l: level) (t: expr) (u: level):
  $ Ind_ty F l $ >
  $ L1 <=l l $ >
  $ LE G t F K u $;
axiom LE_1 (F: expr) (G: ctx) (e: expr) (t: expr) (u: level):
  $ LE_ctor G t F e $ >
  $ LE G t F (K1 e) u $;
term Rec_kappa (u: level) (t F e: expr): prov;
axiom Rec_kappa_0 (P: expr) (l: level) (u: level):
  $ Rec_kappa u P (Sort l) (P -> (Sort u)) $;
axiom Rec_kappa_S (A: expr) (P: expr) (u: level) {x: expr} (B: expr x) (e: expr x):
  $ Rec_kappa u (P @ x) B e $ >
  $ Rec_kappa u P (A. x : A , B) (A. x : A , e) $;
term Rec_app (t C A e: expr): prov;
axiom Rec_app_0 (C: expr) (t: expr):
  $ Rec_app t C t C $;
axiom Rec_app_S (A: expr) (C: expr) (e: expr) (t: expr) (x: expr):
  $ Rec_app t C A e $ >
  $ Rec_app t C (A @ x) (e @ x) $;
term Rec_delta (t C u A e: expr): prov;
axiom Rec_delta_0 (A: expr) (C: expr) (e: expr) (t: expr) (u: expr):
  $ Rec_app t C A e $ >
  $ Rec_delta t C u A (e @ u) $;
axiom Rec_delta_S (A: expr) (t: expr) {x: expr} (C: expr x) (u: expr x) (B: expr x) (e: expr x):
  $ Rec_delta t C (u @ x) B e $ >
  $ Rec_delta t C u (A. x : A , B) (A. x : A , e) $;
term Rec_beta {t: expr} (T C c A e1 e2 e3: expr t): prov;
axiom Rec_beta_app {t: expr} (T: expr t) (C: expr t) (c: expr t) (A: expr t) (A2: expr t) (e1: expr t) (e: expr t):
  $ Rec_app T C A2 e $ >
  $ subst: A [ T / t ] = A2 $ >
  $ Rec_beta t T C c A e1 e1 (e @ c) $;
axiom Rec_beta_Pi {t: expr} {x: expr} (T: expr t x) (A: expr t x) (A2: expr t x) (C: expr t x) (c: expr t x) (B: expr t x) (e1: expr t x) (e2: expr t x) (e3: expr t x):
  $ subst: A [ T / t ] = A2 $ >
  $ Rec_beta t T C (c @ x) B e1 e2 e3 $ >
  $ Rec_beta t T C c (A. x : A , B) (A. x : A2 , e1) e2 e3 $;
axiom Rec_beta_rec {t: expr} {u: expr} (T: expr t u) (A: expr t u) (A2: expr t u) (C: expr t u) (c: expr t u) (D: expr t u) (B: expr t u) (e1: expr t u) (e2: expr t u) (e3: expr t u):
  $ Rec_delta T C u A2 D $ >
  $ subst: A [ T / t ] = A2 $ >
  $ Rec_beta t T C (c @ u) B e1 e2 e3 $ >
  $ Rec_beta t T C c (A -> B) (A. u : A2 , e1) e2 (D -> e3) $;
term Rec_alpha (t F C e: expr): prov;
axiom Rec_alpha_0 (C: expr) (P: expr) (l: level) {z: expr}:
  $ Rec_alpha P (Sort l) C (A. z : P , (C @ z)) $;
axiom Rec_alpha_S (A: expr) (C: expr) (P: expr) {x: expr} (B: expr x) (e: expr x):
  $ Rec_alpha (P @ x) B (C @ x) e $ >
  $ Rec_alpha P (A. x : A , B) C (A. x : A , e) $;
term Rec_epsilon {t: expr} (F: expr) (L: indspec t)
  (C: expr t) (c: cidx) (K: indspec t) (e: expr t): prov;
axiom Rec_epsilon_0 (c: cidx) {t: expr} (F: expr t) (C: expr t) (e: expr t) (L: indspec t):
  $ Rec_alpha (Ind t F L) F C e $ >
  $ Rec_epsilon t F L C c K0 e $;
axiom Rec_epsilon_S (c: cidx) {t: expr} (A: expr t) (F: expr t) (C: expr t) (a: expr t) (e: expr t) (e2: expr t) (K: indspec t) (L: indspec t):
  $ Rec_beta t (Ind t F L) C (Ctor c t F L) a A e2 e2 $ >
  $ Rec_epsilon t F L C (cS c) K e $ >
  $ Rec_epsilon t F L C c (KS a K) (A -> e) $;
axiom ty_Rec {C: expr} (F: expr) (G: ctx) (ka: expr) {t: expr} (u: level) (K: indspec t) (e: expr C):
  $ spec G t F K $ >
  $ LE G t F K u $ >
  $ Rec_kappa u (Ind t F K) F ka $ >
  $ Rec_epsilon t F K C c0 K e $ >
  $ ty G (Rec u t F K) (A. C : ka , e) $;
term iota_delta (t C u A e: expr): prov;
axiom iota_delta_0 (A: expr) (C: expr) (e: expr) (t: expr) (u: expr):
  $ Rec_app t C A e $ >
  $ iota_delta t C u A (e @ u) $;
axiom iota_delta_S (A: expr) (t: expr) {x: expr} (C: expr x) (u: expr x) (B: expr x) (e: expr x):
  $ iota_delta t C (u @ x) B e $ >
  $ iota_delta t C u (A. x : A , B) (\. x : A , e) $;
term iota_beta (G: ctx) {t: expr} (C c A e r1 r2 v1 v2: expr t): prov;
axiom iota_beta_app (G: ctx) {t: expr} (A: expr t) (C: expr t) (c: expr t) (e: expr t) (r: expr t) (v: expr t):
  $ Rec_app t C A e $ >
  $ iota_beta G t C c A (e @ c) r r v v $;
axiom iota_beta_Pi (A: expr) (G: ctx) {t: expr} {x: expr} (C: expr t x) (c: expr t x) (B: expr t x) (e: expr t x) (r1: expr t x) (r2: expr t x) (v1: expr t x) (v2: expr t x):
  $ iota_beta G t C (c @ x) B e (r1 @ x) r2 v1 v2 $ >
  $ iota_beta G t C c (A. x : A , B) e r1 r2 v1 v2 $;
axiom iota_beta_rec (G: ctx) {t: expr} (u: expr) (v: expr) (A: expr t) (C: expr t) (c: expr t) (B: expr t) (e: expr t) (r1: expr t) (r2: expr t) (v1: expr t) (v2: expr t):
  $ iota_delta t C u A v $ >
  $ iota_beta G t C (c @ u) B e (r1 @ u) r2 (v1 @ v) v2 $ >
  $ iota_beta G t C c (A -> B) e r1 r2 v1 v2 $;
term iota_epsilon2 (G: ctx) {t: expr} (F: expr) (L: indspec t)
  (C: expr) (c: cidx) (K: indspec) (R e: expr): prov;
axiom iota_epsilon2_0 (G: ctx) (c: cidx) {t: expr} (K0: indspec t) (L: indspec t) (F: expr t) (C: expr t) (R: expr t):
  $ iota_epsilon2 G t F L C c K0 R R $;
axiom iota_epsilon2_S (G: ctx) (c: cidx) {t: expr} (K: indspec t) (L: indspec t) (A: expr t) (C: expr t) (F: expr t) (R: expr t) (a: expr t) (e: expr t) (r: expr t) (x: expr t):
  $ Rec_beta t (Ind t F L) C (Ctor c t F L) a A r r $ >
  $ ty G x A $ >
  $ iota_epsilon2 G t F L C (cS c) K (R @ x) e $ >
  $ iota_epsilon2 G t F L C c (KS a K) R e $;
term iota_epsilon (G: ctx) {t: expr} (F: expr) (L: indspec t)
  (C: expr) (c: cidx) (K: indspec) (R e1 e2: expr): prov;
axiom iota_epsilon_0 (G: ctx) (c: cidx) {t: expr} (K: indspec t) (L: indspec t) (A: expr t) (C: expr t) (F: expr t) (R: expr t) (R2: expr t) (a: expr t) (e: expr t) (e1: expr t) (e2: expr t) (r: expr t) (x: expr t) (v: expr t):
  $ Rec_beta t (Ind t F L) C (Ctor c t F L) a A r r $ >
  $ ty G e A $ >
  $ iota_beta G t R2 (Ctor c t F L) a e1 e v v e2 $ >
  $ iota_epsilon2 G t F L C (cS c) K (R @ x) R2 $ >
  $ iota_epsilon G t F L C c (KS a K) R e1 e2 $;
axiom iota_epsilon_S (G: ctx) (c: cidx) {t: expr} (K: indspec t) (L: indspec t) (A: expr t) (C: expr t) (F: expr t) (R: expr t) (a: expr t) (e1: expr t) (e2: expr t) (r: expr t) (x: expr t):
  $ Rec_beta t (Ind t F L) C (Ctor c t F L) a A r r $ >
  $ ty G x A $ >
  $ iota_epsilon G t F L C (cS c) K (R @ x) e1 e2 $ >
  $ iota_epsilon G t F L C c (KS a K) R e1 e2 $;
axiom conv_iota (G: ctx) {t: expr} (u: level) (K: indspec t) (C: expr t) (F: expr t) (ka: expr t) (e1: expr t) (e2: expr t):
  $ spec G t F K $ >
  $ LE G t F K u $ >
  $ Rec_kappa u (Ind t F K) F ka $ >
  $ ty G C ka $ >
  $ iota_epsilon G t F K C c0 K ((Rec u t F K) @ C) e1 e2 $ >
  $ conv G e1 e2 $;
def eq (u: level) {.A: expr} {.a: expr} {.t: expr}: expr =
  $ \. A : (Sort u) , (\. a : A , (Ind t (A -> Prop) (K1 (t @ a)))) $;
term quot: level > expr;
axiom ty_quot {A: expr} (u: level):
  $ ty nil (quot u) (A. A : (Sort u) , ((A -> (A -> Prop)) -> (Sort u))) $;
term quot_mk: level > expr;
axiom ty_quot_mk {A: expr} {r: expr} (u: level):
  $ ty nil (quot_mk u) (A. A : (Sort u) , (A. r : (A -> (A -> Prop)) , (A -> (((quot u) @ A) @ r)))) $;
term quot_sound: level > expr;
axiom ty_quot_sound {A: expr} {a: expr} {b: expr} {r: expr} (u: level):
  $ ty nil (quot_sound u) (A. A : (Sort u) , (A. r : (A -> (A -> Prop)) , (A. a : A , (A. b : A , (((r @ a) @ b) -> ((((eq u) @ (((quot u) @ A) @ r)) @ ((((quot_mk u) @ A) @ r) @ a)) @ ((((quot_mk u) @ A) @ r) @ b))))))) $;
term quot_lift: level > level > expr;
axiom ty_quot_lift {A: expr} {B: expr} {a: expr} {b: expr} {f: expr} {r: expr} (u: level) (v: level):
  $ ty nil (quot_lift u v) (A. A : (Sort u) , (A. r : (A -> (A -> Prop)) , (A. B : (Sort v) , (A. f : (A -> B) , ((A. a : A , (A. b : A , (((r @ a) @ b) -> ((((eq v) @ B) @ (f @ a)) @ (f @ b))))) -> ((((quot u) @ A) @ r) -> B)))))) $;
axiom quot_iota (A: expr) (B: expr) (G: ctx) (H: expr) {a: expr} {b: expr} (f: expr) (r: expr) (u: level) (v: level):
  $ ty G A (Sort u) $ >
  $ ty G r (A -> (A -> Prop)) $ >
  $ ty G B (Sort v) $ >
  $ ty G f (A -> B) $ >
  $ ty G H (A. a : A , (A. b : A , (((r @ a) @ b) -> ((((eq v) @ B) @ (f @ a)) @ (f @ b))))) $ >
  $ conv G (((((((quot_lift u v) @ A) @ r) @ B) @ f) @ H) @ ((((quot_mk u) @ A) @ r) @ a)) (f @ a) $;
def iff (p: expr) (q: expr) {.t: expr}: expr =
  $ Ind t Prop (K1 ((p -> q) -> ((q -> p) -> t))) $;
infixl iff: $<->$ prec 6;
term propext: expr;
axiom ty_propext {p: expr} {q: expr}:
  $ ty nil propext (A. p : Prop , (A. q : Prop , ((p <-> q) -> ((((eq L1) @ Prop) @ p) @ q)))) $;
def nonempty (u: level) {.A: expr} {.t: expr}: expr =
  $ \. A : (Sort u) , (Ind t Prop (K1 (A -> t))) $;
term choice: level > expr;
axiom ty_choice {A: expr} (u: level):
  $ ty nil (choice u) (A. A : (Sort u) , (((nonempty u) @ A) -> A)) $;
def nat_spec (t: expr): indspec =
  $ KS t (K1 (t -> t)) $;
def nat {.t: expr}: expr =
  $ Ind t Type (nat_spec t) $;
def nat_zero {.t: expr}: expr =
  $ Ctor c0 t Type (nat_spec t) $;
def nat_succ {.t: expr}: expr =
  $ Ctor (cS c0) t Type (nat_spec t) $;
def nat_rec (u: level) {.t: expr}: expr =
  $ Rec u t Type (nat_spec t) $;
def list_spec (t: expr) (A: expr): indspec =
  $ KS t (K1 (A -> (t -> t))) $;
def list_ind (l: level) (A: expr) {.t: expr}: expr =
  $ Ind t (Sort (l_S l)) (list_spec t A) $;
def list (l: level) {.A: expr}: expr =
  $ \. A : (Sort (l_S l)) , (list_ind l A) $;
def list_ctor (c: cidx) (l: level) (A: expr) {.t: expr}: expr =
  $ Ctor c t (Sort (l_S l)) (list_spec t A) $;
def list_nil (l: level) {.A: expr}: expr =
  $ \. A : (Sort (l_S l)) , (list_ctor c0 l A) $;
def list_cons (l: level) {.A: expr}: expr =
  $ \. A : (Sort (l_S l)) , (list_ctor (cS c0) l A) $;
def list_rec2 (u: level) (l: level) (A: expr) {.t: expr}: expr =
  $ Rec u t (Sort (l_S l)) (list_spec t A) $;
def list_rec (u: level) (l: level) {.A: expr}: expr =
  $ \. A : (Sort (l_S l)) , (list_rec2 u l A) $;
