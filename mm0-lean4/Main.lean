import MM0.Parse
import MM0.MMB
import MM0.GenMM0

/-!
The `mm0-lean` command-line tool.

* `mm0-lean check FILE.mm0`: parse and elaborate a `.mm0` file; exit 0 if it
  is well formed, 1 otherwise (with the reason on stderr).
* `mm0-lean dump FILE.mm0`: print the elaborated `MM0.Env`, one declaration
  per line.
* `mm0-lean lean FILE.mm0 NAME`: print a Lean module defining `NAME : MM0.Env`
  as the elaborated environment, with a comment naming each declaration.
  Checked-in files made this way are regenerated and compared by
  `tests/run.sh`, so they are the parser's output, not hand-written copies.
* `mm0-lean verify FILE.mm0 FILE.mmb`: read the `.mmb` proof file
  (`MM0.MMB`) and check it against the `.mm0` file with the verified checker
  (`MM0.Check.checkFile`); exit 0 if it checks.
* `mm0-lean genmm0 FILE.mm1 FILE.mmb`: print the `.mm0` counterpart of an
  `.mm1` file, with the binders it leaves out filled in from its `.mmb`
  (`MM0.GenMM0`).
* `mm0-lean leanproof FILE.mm0 FILE.mmb ENV MODULE NAME`: print a Lean module
  proving `NAME : ENV.Proof` (with `ENV` defined in `MODULE`), by having the
  kernel run the verified checker on what the reader produced.
-/

open MM0 MM0.Parse

partial def leanSExpr : SExpr → String
  | .var v => s!"(.var {v})"
  | .app t es => s!"(.app {t} [{", ".intercalate (es.map leanSExpr)}])"

def leanBinder : Binder → String
  | .bound s => s!"(.bound {s})"
  | .reg s vs => s!"(.reg {s} {vs})"

def leanCtx (c : Ctx) : String := s!"[{", ".intercalate (c.map leanBinder)}]"

def leanSD (sd : SortData) : String :=
  s!"\{ pure := {sd.pure}, strict := {sd.strict}, provable := {sd.provable}, free := {sd.free} }"

def leanList (l : List SExpr) : String := s!"[{", ".intercalate (l.map leanSExpr)}]"

def leanDecl : Decl → String
  | .sort s sd => s!".sort {s} {leanSD sd}"
  | .term t a r => s!".term {t} {leanCtx a} ({r.1}, {r.2})"
  | .defn t a r none => s!".defn {t} {leanCtx a} ({r.1}, {r.2}) none"
  | .defn t a r (some (ds, v)) =>
    s!".defn {t} {leanCtx a} ({r.1}, {r.2}) (some ({ds}, {leanSExpr v}))"
  | .ax a hs r => s!".ax {leanCtx a} {leanList hs} {leanSExpr r}"
  | .thm a hs r => s!".thm {leanCtx a} {leanList hs} {leanSExpr r}"

/-- The names of the declarations, in order, for comments. -/
def declNames (src : String) : List String :=
  match parseFile src with
  | .ok stmts => stmts.toList.filterMap fun
    | .sort x _ => some s!"sort {x}"
    | .term x .. => some s!"term {x}"
    | .defn x .. => some s!"def {x}"
    | .assert true x .. => some s!"theorem {x}"
    | .assert false x .. => some s!"axiom {x}"
    | _ => none
  | .error _ => []

def leanModule (file name : String) (src : String) (env : Array Decl) : String := Id.run do
  let names := declNames src
  let mut out := s!"import MM0.Spec\n\n/-!\nThe environment of `{file}`, as elaborated by `MM0.Parse`.\n\n" ++
    s!"Generated by `mm0-lean lean {file} {name}`; do not edit. `tests/run.sh`\n" ++
    "regenerates it and checks that it is unchanged.\n-/\n\nnamespace MM0\n\n" ++
    s!"def {name} : Env := [\n"
  let n := env.size
  for h : i in [0:n] do
    let comment := (names[i]?).getD ""
    let sep := if i + 1 == n then "" else ","
    out := out ++ s!"  -- {comment}\n  {leanDecl env[i]}{sep}\n"
  out := out ++ "]\n\nend MM0\n"
  return out

open MM0.Check in
partial def leanConv : ConvPf → String
  | .refl e => s!"(.refl {leanSExpr e})"
  | .symm c => s!"(.symm {leanConv c})"
  | .trans a b => s!"(.trans {leanConv a} {leanConv b})"
  | .cong t cs => s!"(.cong {t} [{", ".intercalate (cs.map leanConv)}])"
  | .unfold t es zs => s!"(.unfold {t} {leanList es} {zs})"

open MM0.Check in
partial def leanPf : Pf → String
  | .hyp n => s!"(.hyp {n})"
  | .thm a hs r σ ps =>
    s!"(.thm {leanCtx a} {leanList hs} {leanSExpr r} {leanList σ} [{", ".intercalate (ps.map leanPf)}])"
  | .conv c p => s!"(.conv {leanConv c} {leanPf p})"

open MM0.Check in
def leanTag : Tag → String
  | .keep => ".keep" | .skip => ".skip" | .define => ".define"

open MM0.Check in
/-- A Lean module proving `envName.Proof` by running the verified checker in
the kernel on what the `.mmb` reader produced. -/
def leanProofModule (mm0 mmb envName envModule name : String) (E' : Env) (tags : List Tag)
    (certs : List (Option ThmCert)) : String := Id.run do
  let mut out := s!"import MM0.Check\nimport {envModule}\n\n/-!\nThe proof file `{mmb}`, " ++
    "as read by `MM0.MMB`, and a kernel-checked proof\n" ++
    s!"that `{mm0}` is proved: `{name} : {envName}.Proof`.\n\n" ++
    s!"Generated by `mm0-lean leanproof {mm0} {mmb} {envName} {envModule} {name}`;\n" ++
    "do not edit. The reader is not trusted: the kernel runs the verified\n" ++
    "checker on its output (`decide +kernel`), and `checkFile_sound` gives the\n" ++
    "theorem.\n-/\n\nnamespace MM0\n\nopen MM0.Check\n\n"
  out := out ++ s!"def {name}Decls : Env := [\n  " ++ ",\n  ".intercalate (E'.map leanDecl) ++ "]\n\n"
  out := out ++ s!"def {name}Tags : List Tag := [" ++ ", ".intercalate (tags.map leanTag) ++ "]\n\n"
  let cert : Option ThmCert → String
    | none => "none"
    | some c => s!"some \{ ds := {c.ds}, pf := {leanPf c.pf} }"
  out := out ++ s!"def {name}Certs : List (Option ThmCert) := [\n  " ++
    ",\n  ".intercalate (certs.map cert) ++ "]\n\n"
  out := out ++ s!"theorem {name} : {envName}.Proof :=\n" ++
    s!"  checkFile_sound (E' := {name}Decls) (tags := {name}Tags) (certs := {name}Certs)\n" ++
    "    (by decide +kernel)\n\nend MM0\n"
  return out

open MM0.Check in
/-- Check an `.mmb` file against a `.mm0` file with the verified checker,
reporting the first declaration that fails. -/
def verify (mm0 mmb : String) : IO UInt32 := do
  let E ← match ← (elabFileIO mm0).run with
    | .ok (env, _) => pure env.toList
    | .error e => IO.eprintln e; return 1
  let bytes ← IO.FS.readBinFile mmb
  let (E', tags, certs) ← match MM0.MMB.read bytes E with
    | .ok r => pure r
    | .error e => IO.eprintln s!"{mmb}: {e}"; return 1
  unless extendGo E E' tags do
    IO.eprintln s!"{mmb}: the proof file does not extend {mm0}"
    return 1
  let mut pre : Env := []
  for (d, c, i) in E'.zip (certs.zip (List.range E'.length)) do
    unless declProofB pre d c do
      IO.eprintln s!"{mmb}: declaration {i} does not check: {reprStr d |>.take 300}"
      return 1
    pre := pre ++ [d]
  if checkFile E E' tags certs then
    IO.println s!"{mmb}: verified ({E'.length} declarations, \
      {(certs.filter Option.isSome).length} proofs)"
    return 0
  else
    IO.eprintln s!"{mmb}: rejected"
    return 1

def main (args : List String) : IO UInt32 := do
  match args with
  | ["verify", mm0, mmb] => verify mm0 mmb
  | ["genmm0", mm1, mmb] =>
    match MM0.GenMM0.genMM0 (← IO.FS.readFile mm1) (← IO.FS.readBinFile mmb) with
    | .ok s => IO.print s; return 0
    | .error e => IO.eprintln s!"{mm1}: {e}"; return 1
  | ["leanproof", mm0, mmb, envName, envModule, name] =>
    let E ← match ← (elabFileIO mm0).run with
      | .ok (env, _) => pure env.toList
      | .error e => IO.eprintln e; return 1
    match MM0.MMB.read (← IO.FS.readBinFile mmb) E with
    | .ok (E', tags, certs) =>
      IO.print (leanProofModule mm0 mmb envName envModule name E' tags certs)
      return 0
    | .error e => IO.eprintln s!"{mmb}: {e}"; return 1
  | [cmd, file] | [cmd, file, _] =>
    match ← (elabFileIO file).run with
    | .error e =>
      IO.eprintln e
      return 1
    | .ok (env, st) =>
      if cmd == "dump" then
        for (x, _) in st.sorts do IO.println s!"sort-name {x}"
        for t in st.terms do IO.println s!"term-name {t.name}"
        for x in st.thms.reverse do IO.println s!"thm-name {x}"
        for d in env do IO.println (reprStr d |>.replace "\n" " ")
      else if cmd == "lean" then
        let some name := args[2]? | IO.eprintln "usage: mm0-lean lean FILE.mm0 NAME"; return 2
        IO.print (leanModule file name (← IO.FS.readFile file) env)
      return 0
  | _ =>
    IO.eprintln "usage: mm0-lean (check|dump) FILE.mm0 | mm0-lean lean FILE.mm0 NAME"
    return 2
